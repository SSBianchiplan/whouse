# GPlanSiS|WHOUSE — variáveis do servidor (copie para /opt/whouse/.env ou exporte no shell).
# Valores FICTÍCIOS: troque pelos seus. Nunca versione o arquivo real.

# Conexão com o PostgreSQL 16+ (o esquema "whouse" é criado sozinho na subida)
WHOUSE_DSN=postgresql://whouse@localhost:5432/whouse

# Login (e-mail) do administrador master: não pode ser rebaixado nem desativado
WHOUSE_MASTER=admin@exemplo.com

# Duração da sessão, em horas (renovada a cada uso)
WHOUSE_SESSAO_HORAS=12

# 0 desliga o cookie Secure — só para desenvolvimento em http://localhost
WHOUSE_COOKIE_SEGURO=1

# Desenvolvimento: pasta do frontend servida pelo próprio uvicorn (em produção o Caddy serve)
# WHOUSE_WEB=../web

# Assistente IA pelo servidor (vazio = motor local de regras no navegador)
ANTHROPIC_API_KEY=
WHOUSE_IA_MODELO=claude-sonnet-5

# Conector REST/Webhook genérico: segredo HMAC compartilhado com o destino
WHOUSE_WEBHOOK_SEGREDO=troque-por-um-segredo-longo
